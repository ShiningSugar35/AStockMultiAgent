{
  "manifest_version": 3,
  "name": "AStock Social Capture",
  "version": "1.0.0",
  "description": "Connects the current Chrome profile's signed-in Xueqiu and Zhihu pages to the local AStock research bridge.",
  "key": "",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://xueqiu.com/*",
    "https://www.xueqiu.com/*",
    "https://www.zhihu.com/*",
    "https://zhuanlan.zhihu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xueqiu.com/*",
        "https://www.xueqiu.com/*",
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "AStock Social Capture"
  }
}
